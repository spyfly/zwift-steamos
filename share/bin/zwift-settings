#!/bin/bash
# "Zwift (Settings)" — rider/user selection and account stuff in the Zluggish
# web UI, shown in the launcher webview (persistent chromium profile, sign-in
# via the preserved remember cookie). No Proton, no token step; the game start
# stays launcherless and reads its persisted token on its own.
set -u

ZWIFT_DATA="${ZWIFT_STEAMOS_DATA:-$HOME/.local/share/zwift-steamos}"
LOG="$ZWIFT_DATA/settings.log"

export ZWIFT_STEAMOS_DATA="$ZWIFT_DATA"
export ZWIFT_CONNECT_IP="${ZWIFT_CONNECT_IP:-192.168.30.240}"
[ -f "$ZWIFT_DATA/zwift-server.pem" ] && export SSL_CERT_FILE="$ZWIFT_DATA/zwift-server.pem"

log() { echo "zwift-settings: $(date '+%F %T') opening settings webview" >>"$LOG" 2>&1 || true; }
log
exec python3 -u "$ZWIFT_DATA/zwift-launcher.py" settings
